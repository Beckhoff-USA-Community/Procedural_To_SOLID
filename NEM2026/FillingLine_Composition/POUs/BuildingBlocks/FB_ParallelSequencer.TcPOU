<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_ParallelSequencer" Id="{fed19bbf-2e70-4866-8588-968960522105}" SpecialFunc="None">
    <Declaration><![CDATA[// Parallel branch coordinator — used inside Inspect for camera + reject-arm
// running concurrently. No other station composes this; no dead weight elsewhere.
FUNCTION_BLOCK FB_ParallelSequencer
VAR_OUTPUT
    AllBranchesComplete : BOOL;
END_VAR
VAR
    _BranchCount : INT;
    _BranchDone  : ARRAY[0..7] OF BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Configure" Id="{bd0a5aa7-6548-4c2d-9465-6c20afd4465f}">
      <Declaration><![CDATA[METHOD Configure : BOOL
VAR_INPUT
    NumberOfBranches : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NumberOfBranches > 0 AND NumberOfBranches <= 8 THEN
    _BranchCount := NumberOfBranches;
    THIS^.ResetAll();
    Configure := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MarkBranchDone" Id="{38f9b6e0-04d7-40aa-afe9-69134cc31d17}">
      <Declaration><![CDATA[METHOD MarkBranchDone : BOOL
VAR_INPUT
    BranchIndex : INT;
END_VAR
VAR
    Index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF BranchIndex >= 0 AND BranchIndex < _BranchCount THEN
    _BranchDone[BranchIndex] := TRUE;
END_IF

AllBranchesComplete := TRUE;
FOR Index := 0 TO _BranchCount - 1 DO
    IF NOT _BranchDone[Index] THEN
        AllBranchesComplete := FALSE;
        EXIT;
    END_IF
END_FOR

MarkBranchDone := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetAll" Id="{6e8d4a37-7f3e-4645-b814-7a2ace845c04}">
      <Declaration><![CDATA[METHOD ResetAll : BOOL
VAR
    Index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AllBranchesComplete := FALSE;
FOR Index := 0 TO 7 DO
    _BranchDone[Index] := FALSE;
END_FOR
ResetAll := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
