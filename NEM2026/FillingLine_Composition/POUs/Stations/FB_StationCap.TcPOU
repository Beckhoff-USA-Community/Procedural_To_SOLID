      <Declaration><![CDATA[PROPERTY CapFeederReady : BOOL]]></Declaration>
      <Get Name="Get" Id="{3a417374-cf31-48a1-86a2-aade6b98f4fb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CapFeederReady := _CapFeederReady;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c581f3eb-7bd1-4848-8a03-dc34e1064bd5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CapFeederReady := CapFeederReady;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="CapPickCylinder" Id="{7b511410-1b3e-445a-8a7a-62379569510f}" FolderPath="Station\">
      <Declaration><![CDATA[PROPERTY CapPickCylinder : BOOL]]></Declaration>
      <Get Name="Get" Id="{f47d7be4-8b0c-40a5-a6c6-c8cf3fbadce4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CapPickCylinder := _CapPickCylinder;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{34c62732-e038-49b0-8d17-4aa21769b157}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CapPickCylinder := CapPickCylinder;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Execute" Id="{608dcedc-4e88-4976-b35e-bbd937e8a684}">
      <Declaration><![CDATA[METHOD Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Watchdog.CyclicUpdate();

IF Watchdog.TimedOut THEN
    Alarm.RaiseAlarm(Code := 2000, Text := 'Cap: Timeout');
    RETURN;
END_IF

IF Mode.IsPaused THEN
	StatusText := 'Paused';
	RETURN;
END_IF

CASE Sequencer.CurrentStep OF
    0:
        _RunCapMotor     := FALSE;
        _CapPickCylinder := FALSE;
        Watchdog.Reset();
        IF Mode.AllowRun AND _PartPresent AND _CapFeederReady THEN
            Sequencer.TransitionTo(10);
            Watchdog.Enable := TRUE;
            Watchdog.Duration := T#10S;
        END_IF

    10:
        _CapPickCylinder := TRUE;
        _CapSettle(IN := TRUE, PT := T#500MS);
        IF _CapSettle.Q THEN
            _CapSettle(IN := FALSE);
            Sequencer.TransitionTo(20);
        END_IF

    20:
        _RunCapMotor := TRUE;
        IF _TorqueActual >= _TorqueLimit THEN
            _RunCapMotor := FALSE;
            Sequencer.TransitionTo(30);
        END_IF

    30:
        _CapPickCylinder := FALSE;
        Watchdog.Enable := FALSE;
        Sequencer.MarkComplete();
END_CASE

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{9247cdc9-c31f-4ca9-b83c-6f9b47f4f84f}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains 	: BOOL;
    bInCopyCode  	: BOOL;
    Mode	      	: I_ModeProvider;
    AlarmHandler 	: I_AlarmHandler;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Mode  := Mode;
THIS^.Alarm := AlarmHandler;

Sequencer.SetStepName(0,  'Idle');
Sequencer.SetStepName(10, 'Pick Cap');
Sequencer.SetStepName(20, 'Torquing');
Sequencer.SetStepName(30, 'Complete');

FB_Init := TRUE;
]]></ST>
      </Implementation>
    </Method>
