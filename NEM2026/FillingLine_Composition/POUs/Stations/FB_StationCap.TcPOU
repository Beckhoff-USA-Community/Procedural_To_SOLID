<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationCap" Id="{c02a0884-fe5f-4ce9-9dfb-dc42bc5c112b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationCap IMPLEMENTS I_Sequenceable, I_HmiReportable, I_Cap
VAR
    Mode      : I_ModeProvider;
    Alarm     : I_AlarmHandler;
    Sequencer : FB_StepSequencer;
    Watchdog  : FB_TimeoutWatchdog;
	
	// inputs
    _PartPresent    : BOOL;
    _CapFeederReady : BOOL;
    _TorqueLimit    : LREAL;
    _TorqueActual   : LREAL;
	
	// outputs
    _RunCapMotor     : BOOL;
    _CapPickCylinder : BOOL;
	
    _CapSettle : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Station" Id="{f6e958ff-ae11-47f9-bc49-d9a12b6ab229}" />
    <Method Name="Abort" Id="{047d863c-3951-4a3b-ba3f-e98a949848cf}">
      <Declaration><![CDATA[METHOD Abort : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RunCapMotor     := FALSE;
_CapPickCylinder := FALSE;
Sequencer.ResetSequencer();
Watchdog.Reset();
Abort := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="AlarmActive" Id="{bcd54691-372a-4e5c-9f64-7599a3ed2c46}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmActive : BOOL
]]></Declaration>
      <Get Name="Get" Id="{b80c258f-5710-4bc7-91a5-744271f09251}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmActive := Alarm.HasActiveAlarm;]]></ST>
        </Implementation>
      </Get>
    </Property>
