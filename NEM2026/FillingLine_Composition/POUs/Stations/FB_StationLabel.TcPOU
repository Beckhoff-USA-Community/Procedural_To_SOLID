      </Set>
    </Property>
    <Method Name="Reset" Id="{2e503d8f-854d-4aae-a37a-e1cebb19918f}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Sequencer.ResetSequencer();
Watchdog.Reset();
Alarm.Clear();
_LabelVacuum      := FALSE;
_ExtendApplicator := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
