<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationLabel" Id="{f3ee44de-5d03-4f62-a530-f5976f241c48}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationLabel IMPLEMENTS I_Sequenceable, I_HmiReportable, I_Label
VAR
    Mode      : I_ModeProvider;
    Alarm     : I_AlarmHandler;
    Sequencer : FB_StepSequencer;
    Watchdog  : FB_TimeoutWatchdog;
	
	// inputs
    _PartPresent   : BOOL;
    _LabelReady    : BOOL;
    _ApplyPressure : LREAL;
	
	// outputs
    _ExtendApplicator : BOOL;
    _LabelVacuum      : BOOL;
	
    _ApplySettle : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Station" Id="{4a0ab884-455d-4391-bb66-b0bb00b7157e}" />
    <Method Name="Abort" Id="{faee233e-ed17-4745-b00d-ebe81d4bad87}">
      <Declaration><![CDATA[METHOD Abort : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LabelVacuum      := FALSE;
_ExtendApplicator := FALSE;
Sequencer.ResetSequencer();
Watchdog.Reset();
Abort := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="AlarmActive" Id="{7e1b1249-9846-4d8e-bac6-7965406ba594}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmActive : BOOL
]]></Declaration>
      <Get Name="Get" Id="{bd778c0f-7cc1-42f7-b1c3-2436da6e85e1}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmActive := Alarm.HasActiveAlarm;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AlarmMessage" Id="{c0ae0221-1fa0-4c37-99ca-1a86b24ba6a4}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmMessage : STRING(255)
]]></Declaration>
      <Get Name="Get" Id="{eb820d54-616f-4497-9058-b943ca3ff302}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmMessage := Alarm.AlarmText;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ApplyPressure" Id="{087d3fb2-8274-49eb-bd79-9b0973e2bde2}" FolderPath="Station\">
      <Declaration><![CDATA[PROPERTY ApplyPressure : LREAL]]></Declaration>
      <Set Name="Set" Id="{56c89e9a-cb02-4b2d-b9db-4ddca3aff399}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ApplyPressure := ApplyPressure;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Execute" Id="{830b91c4-4c5a-40e2-add0-929664a83c18}">
      <Declaration><![CDATA[METHOD Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Watchdog.CyclicUpdate();

IF Watchdog.TimedOut THEN
    Alarm.RaiseAlarm(Code := 3000, Text := 'Label: Timeout');
    RETURN;
END_IF

CASE Sequencer.CurrentStep OF
    0:
        _LabelVacuum      := FALSE;
        _ExtendApplicator := FALSE;
        Watchdog.Reset();
        IF Mode.AllowRun AND _PartPresent AND _LabelReady THEN
            Sequencer.TransitionTo(10);
            Watchdog.Enable := TRUE;
            Watchdog.Duration := T#5S;
        END_IF

    10:
        _LabelVacuum := TRUE;
        _ApplySettle(IN := TRUE, PT := T#300MS);
        IF _ApplySettle.Q THEN
            _ApplySettle(IN := FALSE);
            Sequencer.TransitionTo(20);
        END_IF

    20:
        _ExtendApplicator := TRUE;
        _ApplySettle(IN := TRUE, PT := T#400MS);
        IF _ApplySettle.Q THEN
            _ApplySettle(IN := FALSE);
            _ExtendApplicator := FALSE;
            Sequencer.TransitionTo(30);
        END_IF

    30:
        _LabelVacuum := FALSE;
        Watchdog.Enable := FALSE;
        Sequencer.MarkComplete();
END_CASE

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExtendApplicator" Id="{178fe857-c537-47ca-ad0b-d0aa6ad8f27c}" FolderPath="Station\">
      <Declaration><![CDATA[PROPERTY ExtendApplicator : BOOL]]></Declaration>
      <Get Name="Get" Id="{a294b43b-f494-41c7-a95d-f571e2200ff4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExtendApplicator := _ExtendApplicator;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0bd6ba6f-7fc0-490d-9324-3854971b0040}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ExtendApplicator := ExtendApplicator;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{a63f953d-2630-4355-bf11-72416dc95e7e}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains 	: BOOL;
    bInCopyCode  	: BOOL;
    Mode      		: I_ModeProvider;
    AlarmHandler 	: I_AlarmHandler;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Mode  := Mode;
THIS^.Alarm := AlarmHandler;

Sequencer.SetStepName(0,  'Idle');
Sequencer.SetStepName(10, 'Pick Label');
Sequencer.SetStepName(20, 'Applying');
Sequencer.SetStepName(30, 'Complete');

FB_Init := TRUE;
]]></ST>
      </Implementation>
    </Method>
