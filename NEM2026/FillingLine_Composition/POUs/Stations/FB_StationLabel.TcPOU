    <Property Name="PartPresent" Id="{fa6caefe-ee21-4e62-986a-ea41d4ecd2c1}" FolderPath="Station\">
      <Declaration><![CDATA[PROPERTY PartPresent : BOOL]]></Declaration>
      <Set Name="Set" Id="{aa33884d-f41c-4d57-9dff-2b0f23f8f8c5}">
