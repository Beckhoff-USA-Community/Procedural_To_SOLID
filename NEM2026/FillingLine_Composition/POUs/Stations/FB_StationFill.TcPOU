    </Property>
    <Property Name="TargetVolume" Id="{3727774a-68b8-43dc-b90f-d453a1200513}" FolderPath="Station\">
      <Declaration><![CDATA[PROPERTY TargetVolume : LREAL]]></Declaration>
      <Set Name="Set" Id="{ec52f456-79d6-41f2-9fd5-60e0fb035d11}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_TargetVolume := TargetVolume;]]></ST>
