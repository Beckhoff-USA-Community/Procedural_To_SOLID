      </Get>
    </Property>
    <Property Name="StatusText" Id="{e0a3f376-d719-4e72-9e3f-edebf897b70d}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY StatusText : STRING(80)
]]></Declaration>
      <Get Name="Get" Id="{4968e57e-84a5-4ae0-95b9-fc7d507e1685}">
