    <Method Name="Reset" Id="{955e4987-ee94-4bf5-928f-ab57a8fd0927}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Sequencer.ResetSequencer();
Parallel.ResetAll();
Watchdog.Reset();
Alarm.Clear();
_TriggerCamera := FALSE;
_RejectPusher  := FALSE;
_PassResult    := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
