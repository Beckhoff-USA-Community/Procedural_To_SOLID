    <Method Name="Reset" Id="{75bf388c-59fa-4106-9bea-ec109c431cb8}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Sequencer.ResetSequencer();
Parallel.ResetAll();
Watchdog.Reset();
Alarm.Clear();
_TriggerCamera := FALSE;
_RejectPusher  := FALSE;
_PassResult    := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
