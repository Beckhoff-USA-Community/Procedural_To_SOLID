<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationInspect" Id="{27ea943e-23a0-4572-b348-441c08bdd056}" SpecialFunc="None">
    <Declaration><![CDATA[// Stage-3-composition variant: Inspect now uses FB_ParallelSequencer to run
// camera capture + reject pre-arm concurrently in step 10, and is wired with
// FB_AlarmHandler_QualityFlag in MAIN (non-latching, StopsLine = FALSE).
// The other stations are unchanged — that's the point of composition.
FUNCTION_BLOCK FB_StationInspect IMPLEMENTS I_Sequenceable, I_HmiReportable
VAR_INPUT
    PartPresent   : BOOL;
    CameraReady   : BOOL;
    InspectResult : BOOL;
END_VAR
VAR_OUTPUT
    TriggerCamera : BOOL;
    RejectPusher  : BOOL;
    PassResult    : BOOL;
END_VAR
VAR
    Mode      		: I_ModeProvider;
    Alarm     		: I_AlarmHandler;
	DataLogger 	  	: I_DataLogger;
    Sequencer 		: FB_StepSequencer;
    Parallel  		: FB_ParallelSequencer;   // not used by other stations
    Watchdog  		: FB_TimeoutWatchdog;
    _CameraDelay 	: TON;
    _RejectDelay 	: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Abort" Id="{e24f866c-8920-4a9f-a3a9-6e286da6901d}">
      <Declaration><![CDATA[METHOD Abort : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TriggerCamera := FALSE;
RejectPusher  := FALSE;
Sequencer.ResetSequencer();
Parallel.ResetAll();
Watchdog.Reset();
Abort := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="AlarmActive" Id="{c8e16a60-dc2a-4a63-b57b-056b7505b7e2}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmActive : BOOL
]]></Declaration>
      <Get Name="Get" Id="{f6d59357-c205-4fca-b846-a72f0e15692e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmActive := Alarm.HasActiveAlarm;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AlarmMessage" Id="{bae7b94f-9016-480e-8511-37f23fbede44}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmMessage : STRING(255)
]]></Declaration>
      <Get Name="Get" Id="{970c2550-8854-4ad0-be33-29eccf455f88}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmMessage := Alarm.AlarmText;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{f2c9ae5f-caf1-4f4d-9ab4-c06d07e9ebe2}">
      <Declaration><![CDATA[METHOD Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Watchdog.CyclicUpdate();

IF Watchdog.TimedOut THEN
    Alarm.RaiseAlarm(Code := 4000, Text := 'Inspect: Timeout');
    RETURN;
END_IF

CASE Sequencer.CurrentStep OF
    0:
        TriggerCamera := FALSE;
        RejectPusher  := FALSE;
        PassResult    := FALSE;
        Watchdog.Reset();
        Parallel.ResetAll();
        IF Mode.AllowRun AND PartPresent AND CameraReady THEN
            Sequencer.TransitionTo(10);
            Watchdog.Enable := TRUE;
            Watchdog.Duration := T#5S;
        END_IF

    10: // PARALLEL: camera capture + reject pre-arm
        // Branch 0 — camera
        TriggerCamera := TRUE;
        _CameraDelay(IN := TRUE, PT := T#200MS);
        IF _CameraDelay.Q THEN
            _CameraDelay(IN := FALSE);
            TriggerCamera := FALSE;
            Parallel.MarkBranchDone(BranchIndex := 0);
        END_IF
        // Branch 1 — reject arm (move to ready position)
        RejectPusher := FALSE;
        _RejectDelay(IN := TRUE, PT := T#150MS);
        IF _RejectDelay.Q THEN
            _RejectDelay(IN := FALSE);
            Parallel.MarkBranchDone(BranchIndex := 1);
        END_IF
        // wait for both branches
        IF Parallel.AllBranchesComplete THEN
            Sequencer.TransitionTo(20);
        END_IF

    20:
        IF InspectResult THEN
            PassResult := TRUE;
            Sequencer.TransitionTo(30);
        ELSE
            PassResult := FALSE;
            Alarm.RaiseAlarm(Code := 4001, Text := 'Inspect: Visual defect');
            Sequencer.TransitionTo(25);
        END_IF

    25:
        RejectPusher := TRUE;
        _CameraDelay(IN := TRUE, PT := T#300MS);
        IF _CameraDelay.Q THEN
            _CameraDelay(IN := FALSE);
            RejectPusher := FALSE;
            Sequencer.TransitionTo(30);
        END_IF

    30:
        Watchdog.Enable := FALSE;
        Sequencer.MarkComplete();
END_CASE

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{60185f67-94d9-4951-909a-d4d9c818919f}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains 	: BOOL;
    bInCopyCode  	: BOOL;
    Mode      		: I_ModeProvider;
    AlarmHandler 	: I_AlarmHandler;
	DataLogger 	  	: I_DataLogger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Mode  := Mode;
THIS^.Alarm := AlarmHandler;

Sequencer.SetStepName(0,  'Idle');
Sequencer.SetStepName(10, 'Inspecting (parallel)');
Sequencer.SetStepName(20, 'Evaluate');
Sequencer.SetStepName(25, 'Rejecting');
Sequencer.SetStepName(30, 'Complete');

Parallel.Configure(NumberOfBranches := 2);

FB_Init := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsComplete" Id="{cc69c8db-8f76-4a10-9f67-141e9bfadb1b}">
      <Declaration><![CDATA[PROPERTY IsComplete : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ff39a703-30ef-4168-98a2-76ad5fa0ec3d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsComplete := Sequencer.Complete;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsFaulted" Id="{19b03815-98cf-460d-a9e7-ccf5acbe4848}">
      <Declaration><![CDATA[PROPERTY IsFaulted : BOOL
]]></Declaration>
      <Get Name="Get" Id="{dececa2d-8556-4a52-8c16-6bcf2a20c49e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsFaulted := Alarm.HasActiveAlarm AND Alarm.StopsLine;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{75bf388c-59fa-4106-9bea-ec109c431cb8}">
      <Declaration><![CDATA[METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Sequencer.ResetSequencer();
Parallel.ResetAll();
Watchdog.Reset();
Alarm.Clear();
TriggerCamera := FALSE;
RejectPusher  := FALSE;
PassResult    := FALSE;
Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="StateName" Id="{2c07ad89-df6a-493f-ba6e-331382598806}">
      <Declaration><![CDATA[PROPERTY StateName : STRING(40)
]]></Declaration>
      <Get Name="Get" Id="{42d3b562-c9ec-4e6f-8a91-7ea7667552de}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateName := Sequencer.StepName;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StateNumber" Id="{c69b123a-c8f1-4d1d-a7b7-419a27e45710}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY StateNumber : INT
]]></Declaration>
      <Get Name="Get" Id="{5e0144e3-a5de-421b-95d9-0903d2cc7482}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StateNumber := Sequencer.CurrentStep;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StatusText" Id="{f8f6e8c1-39f1-4d6e-892b-899fc1c10877}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY StatusText : STRING(80)
]]></Declaration>
      <Get Name="Get" Id="{a365acbd-4c6c-4e1a-875d-598867a70b8a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StatusText := Sequencer.StepName;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>