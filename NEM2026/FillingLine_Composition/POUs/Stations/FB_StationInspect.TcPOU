<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationInspect" Id="{27ea943e-23a0-4572-b348-441c08bdd056}" SpecialFunc="None">
    <Declaration><![CDATA[// Stage-3-composition variant: Inspect now uses FB_ParallelSequencer to run
// camera capture + reject pre-arm concurrently in step 10, and is wired with
// FB_AlarmHandler_QualityFlag in MAIN (non-latching, StopsLine = FALSE).
// The other stations are unchanged — that's the point of composition.
FUNCTION_BLOCK FB_StationInspect IMPLEMENTS I_Sequenceable, I_HmiReportable, I_Inspect
VAR
    Mode      		: I_ModeProvider;
    Alarm     		: I_AlarmHandler;
	DataLogger 	  	: I_DataLogger;
    Sequencer 		: FB_StepSequencer;
    Parallel  		: FB_ParallelSequencer;   // not used by other stations
    Watchdog  		: FB_TimeoutWatchdog;
	
	// inputs
    _PartPresent   : BOOL;
    _CameraReady   : BOOL;
    _InspectResult : BOOL;

	// outputs
    _TriggerCamera : BOOL;
    _RejectPusher  : BOOL;
    _PassResult    : BOOL;
	
    _CameraDelay 	: TON;
    _RejectDelay 	: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Station" Id="{c0ef751c-4760-4767-a9d5-413059894452}" />
    <Method Name="Abort" Id="{e24f866c-8920-4a9f-a3a9-6e286da6901d}">
      <Declaration><![CDATA[METHOD Abort : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TriggerCamera := FALSE;
_RejectPusher  := FALSE;
Sequencer.ResetSequencer();
Parallel.ResetAll();
Watchdog.Reset();
Abort := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="AlarmActive" Id="{c8e16a60-dc2a-4a63-b57b-056b7505b7e2}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmActive : BOOL
]]></Declaration>
      <Get Name="Get" Id="{f6d59357-c205-4fca-b846-a72f0e15692e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmActive := Alarm.HasActiveAlarm;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AlarmMessage" Id="{bae7b94f-9016-480e-8511-37f23fbede44}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmMessage : STRING(255)
]]></Declaration>
      <Get Name="Get" Id="{970c2550-8854-4ad0-be33-29eccf455f88}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmMessage := Alarm.AlarmText;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CameraReady" Id="{35951283-7359-4b19-9e15-b39aa114201e}" FolderPath="Station\">
      <Declaration><![CDATA[PROPERTY CameraReady : BOOL]]></Declaration>
      <Set Name="Set" Id="{f92418bf-5dc9-49d4-8473-339c8b446756}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_CameraReady := CameraReady;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Execute" Id="{f2c9ae5f-caf1-4f4d-9ab4-c06d07e9ebe2}">
      <Declaration><![CDATA[METHOD Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Watchdog.CyclicUpdate();

IF Watchdog.TimedOut THEN
    Alarm.RaiseAlarm(Code := 4000, Text := 'Inspect: Timeout');
    RETURN;
END_IF

CASE Sequencer.CurrentStep OF
    0:
        _TriggerCamera := FALSE;
        _RejectPusher  := FALSE;
        _PassResult    := FALSE;
        Watchdog.Reset();
        Parallel.ResetAll();
        IF Mode.AllowRun AND _PartPresent AND _CameraReady THEN
            Sequencer.TransitionTo(10);
            Watchdog.Enable := TRUE;
            Watchdog.Duration := T#5S;
        END_IF

    10: // PARALLEL: camera capture + reject pre-arm
        // Branch 0 — camera
        _TriggerCamera := TRUE;
        _CameraDelay(IN := TRUE, PT := T#200MS);
        IF _CameraDelay.Q THEN
            _CameraDelay(IN := FALSE);
            _TriggerCamera := FALSE;
            Parallel.MarkBranchDone(BranchIndex := 0);
        END_IF
        // Branch 1 — reject arm (move to ready position)
        _RejectPusher := FALSE;
        _RejectDelay(IN := TRUE, PT := T#150MS);
        IF _RejectDelay.Q THEN
            _RejectDelay(IN := FALSE);
            Parallel.MarkBranchDone(BranchIndex := 1);
        END_IF
        // wait for both branches
        IF Parallel.AllBranchesComplete THEN
            Sequencer.TransitionTo(20);
        END_IF

    20:
        IF _InspectResult THEN
            _PassResult := TRUE;
            Sequencer.TransitionTo(30);
        ELSE
            _PassResult := FALSE;
            Alarm.RaiseAlarm(Code := 4001, Text := 'Inspect: Visual defect');
            Sequencer.TransitionTo(25);
        END_IF

    25:
        _RejectPusher := TRUE;
        _CameraDelay(IN := TRUE, PT := T#300MS);
        IF _CameraDelay.Q THEN
            _CameraDelay(IN := FALSE);
            _RejectPusher := FALSE;
            Sequencer.TransitionTo(30);
        END_IF

    30:
        Watchdog.Enable := FALSE;
        // CR-3: log cycle on completion.
        DataLogger.LogCycleData(StationName := 'Inspect',
                                StepNumber  := Sequencer.CurrentStep,
                                CycleTimeMs := 0);
        Sequencer.MarkComplete();
END_CASE

Execute := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{60185f67-94d9-4951-909a-d4d9c818919f}">
      <Declaration><![CDATA[METHOD FB_Init : BOOL
VAR_INPUT
    bInitRetains 	: BOOL;
    bInCopyCode  	: BOOL;
    Mode      		: I_ModeProvider;
    AlarmHandler 	: I_AlarmHandler;
	DataLogger 	  	: I_DataLogger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Mode       := Mode;
THIS^.Alarm      := AlarmHandler;
THIS^.DataLogger := DataLogger;

Sequencer.SetStepName(0,  'Idle');
Sequencer.SetStepName(10, 'Inspecting (parallel)');
Sequencer.SetStepName(20, 'Evaluate');
Sequencer.SetStepName(25, 'Rejecting');
Sequencer.SetStepName(30, 'Complete');

Parallel.Configure(NumberOfBranches := 2);

FB_Init := TRUE;
]]></ST>
      </Implementation>
    </Method>
