 the start (Mode flags + Alarm.Clear()) so prior test residue can't leak.]]></Comment><SubItem><Name Static="true">Mode</Name><Type>FB_ModeManager</Type><BitSize>128</BitSize></SubItem><SubItem><Name Static="true">AlarmLineFault</Name><Type>FB_AlarmHandler_LineFault</Type><BitSize>2240</BitSize></SubItem><SubItem><Name Static="true">AlarmQualityFlag</Name><Type>FB_AlarmHandler_QualityFlag</Type><BitSize>2176</BitSize></SubItem><SubItem><Name Static="true">Logger</Name><Type>FB_CycleDataLogger</Type><BitSize>51328</BitSize></SubItem></DataType><DataType><Name GUID="{0E3EE943-5C22-43B5-BA32-F2D88FA6AD91}">TestEvents</Name><DisplayName TxtId=""><![CDATA[EventClass1_DisplayText]]></DisplayName><EventId><Name Id="1">TestEvent</Name><DisplayName TxtId=""><![CDATA[{0}]]></DisplayName><Severity>Error</Severity></EventId></DataType></DataTypes><Modules><Module GUID="{7296CC47-455C-4BA0-8F4D-727DF8245047}" TcSmClass="TComPlcObjDef" TargetPlatform="TwinCAT OS (ARMV7-A)"><Name>FillingLine</Name><CLSID ClassFactory="TcPlc30">{08500001-0000-0000-F000-000000000064}</CLSID><Licenses /><Contexts><Context><Id NeedCalleeCall="true">0</Id><Name>PlcTask</Name><DependOn>FixedConfig</DependOn><Priority>20</Priority><CycleTime>10000000</CycleTime></Context></Contexts><Parameters><Parameter ReadOnly="True"><Name>DeviceLog Filter</Name><BaseType>UDINT</BaseType><PTCID>#x08508045</PTCID></Parameter></Parameters><ParameterValues><Value><Name>DeviceLog Filter</Name><Data>00000000</Data></Value></ParameterValues><DataAreas><DataArea><AreaNo AreaType="Internal" CreateSymbols="true">3</AreaNo><Name>PlcTask Internal</Name><ContextId>0</ContextId><ByteSize>11010048</ByteSize><Symbol TcContextMask="#x00000000"><Name>Global_Version.stLibVersion_Core</Name><BitSize>288</BitSize><BaseType GUID="{6F5942ED-BFA1-497D-8225-23C6DAAD0A09}">ST_LibVersion</BaseType><Default><SubItem><Name>.iMajor</Name><Value>1</Value></SubItem><SubItem><Name>.iMinor</Name><Value>3</Value></SubItem><SubItem><Name>.iBuild</Name>