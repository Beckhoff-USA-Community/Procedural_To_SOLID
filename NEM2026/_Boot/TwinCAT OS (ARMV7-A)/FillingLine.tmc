m><SubItem><Name Static="true">TestSuite</Name><Type Namespace="Tc3_PlcTestSuite">TestSuite&lt;50&gt;</Type><BitSize>525056</BitSize></SubItem></DataType><DataType><Name Namespace="Tc3_PlcTestSuite">TestSuiteParameter</Name><SubItem><Name Static="true">MaxTestCount</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>50</Value></Default></SubItem><SubItem><Name Static="true">DefaultPath</Name><Type>STRING(80)</Type><BitSize>648</BitSize><Default><String>C:\ProgramData\Beckhoff\TwinCAT\3.1\Boot\TEST_Result.xml</String></Default></SubItem><Properties><Property><Name>parameterlist</Name></Property><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Tc3_PlcTestFramework">TestController</Name><SubItem><Name Static="true">TestCtrl</Name><Type Namespace="Tc3_PlcTestFramework">FB_TestSuiteController</Type><Comment><![CDATA[ global test controller instance that should be called from MAIN and be accessible without GVL name (unqualified) ]]></Comment><BitSize>2496</BitSize><Properties><Property><Name>old_input_assignments</Name></Property></Properties></SubItem></DataType><DataType><Name Namespace="Tc3_PlcTestFramework">Param</Name><SubItem><Name Static="true">MaxTestCaseCount</Name><Type>UDINT</Type><Comment><![CDATA[ set to 0 to disable library-internal test controller]]></Comment><BitSize>32</BitSize><Default><Value>100</Value></Default></SubItem><SubItem><Name Static="true">DefaultTimeout</Name><Type>TIME</Type><BitSize>32</BitSize><Default><DateTime>2000</DateTime></Default></SubItem><SubItem><Name Static="true">DefaultOwner</Name><Type>STRING(255)</Type><BitSize>2048</BitSize><Default><String>&lt;no owner defined&gt;</String></Default></SubItem><Properties><Property><Name>parameterlist</Name></Property><Property><Name>qualified_only</Name></Property><Property><Name>global_init_slot</Name><Value>40400</Value></Property></Properties></DataType><DataType><Name Namespace="Tc3_PlcTestFramework">TestCtrlItf</Name><Comment><![CDATA[ 
	"Test-Control-Interface"
	This is the high level interface between the PLC test case and a test client application.
	They communicate via ADSRead/Write though these variables (port 851).
	You should not write to these variables, only the "FB_TestSuiteController"
	NEVER use two instances in any application!
]]></Comment><SubItem><Name Static="true">g_bBreakOnError</Name><Type>BOOL</Type><Comment><![CDATA[ stop PLC when any assertion fails ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">g_bCaseUsesDialog</Name><Type>BOOL</Type><Comment><![CDATA[ testcase selected by g_nCaseNo MIGHT require manual interaction via dialog (optional), g_nCurrentDialogInvocationId will be monitored by Client]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">g_bReadyToStart</Name><Type>BOOL</Type><Comment><![CDATA[ Indicates if TestCase is Cleaned up and ready for Next TestCase without Restarting TwinCAT ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">g_bStart</Name><Type>BOOL</Type><Comment><![CDATA[ to start the testcase. Client sets this to true, MUST be monitored from test, rising edge triggers start ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">g_bStarted</Name><Type>BOOL</Type><Comment><![CDATA[ preparation is finished. Client subscribes to this, MUST be set from test, timeout mechanisms on client side can start now ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">g_sSuiteName</Name><Type>STRING(255)</Type><Comment><![CDATA[ name of test suite ]]></Comment><BitSize>2048</BitSize><Default><String>&lt;unnamed test suite&gt;</String></Default></SubItem><SubItem><Name Static="true">g_nCasesCnt</Name><Type>UDINT</Type><Comment><![CDATA[ count of  testcases. 0 if none or TestCtrl not yet called ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_nCycleCnt</Name><Type>UDINT</Type><Comment><![CDATA[ incremented each PLC cylce to indicate alive application ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_nActiveCycleCnt</Name><Type>UDINT</Type><Comment><![CDATA[ incremented each PLC cylce while TestCase is active ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_nCaseNo</Name><Type>UDINT</Type><Comment><![CDATA[ testcase number to select for execution and (from 1 to nSubCasesCnt or 0 when nCasesCnt=0). Client sets this before starting the test, MUST be read from test ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_nCaseTimeout</Name><Type>TIME</Type><Comment><![CDATA[ (externally enforced) timeout for testcase selected by g_nCaseNo ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_sCaseName</Name><Type>STRING(255)</Type><Comment><![CDATA[ descriptive information for testcase selected by g_nCaseNo ]]></Comment><BitSize>2048</BitSize></SubItem><SubItem><Name Static="true">g_sCaseOwner</Name><Type>STRING(255)</Type><Comment><![CDATA[ Owner of the testcase ]]></Comment><BitSize>2048</BitSize></SubItem><SubItem><Name Static="true">g_sCaseInstName</Name><Type>STRING(255)</Type><Comment><![CDATA[ instance name for testcase selected by g_nCaseNo (optional) ]]></Comment><BitSize>2048</BitSize></SubItem><SubItem><Name Static="true">g_nCurStep</Name><Type>UDINT</Type><Comment><![CDATA[ indicate steps inside testcase. Client reads it while testcase is started but not done, CAN be set from test ]]></Comment><BitSize>32</BitSize><Default><Value>0</Value></Default></SubItem><SubItem><Name Static="true">g_bDone</Name><Type>BOOL</Type><Comment><![CDATA[ testcase is finished. Client subscribes to this, MUST be set from test ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">g_bError</Name><Type>BOOL</Type><Comment><![CDATA[ testcase is finished and was NOT successful. Client reads after g_bDone went to true, MUST be set from test ]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">g_sFinalMessage</Name><Type>STRING(255)</Type><Comment><![CDATA[ further information that could be displayed in test client, after test is done, CAN be set from test ]]></Comment><BitSize>2048</BitSize><Default><String /></Default></SubItem><SubItem><Name Static="true">g_sCycleTimeData</Name><Type>STRING(255)</Type><Comment><![CDATA[ further information that Shows some cycletime infos ]]></Comment><BitSize>2048</BitSize><Default><String /></Default></SubItem><SubItem><Name Static="true">g_nDialogCurrentInvokeId</Name><Type>UDINT</Type><Comment><![CDATA[ if !=0, indicates that manual user interaction is required, CAN be set by test case if it signals g_bCaseUsesDialog=true]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_sDialogMessage</Name><Type>STRING(255)</Type><Comment><![CDATA[ message that will be diplayed in User Dialog, CAN be set from test if it signals g_bCaseUsesDialog=true ]]></Comment><BitSize>2048</BitSize><Default><String /></Default></SubItem><SubItem><Name Static="true">g_nDialogButtons</Name><Type>DWORD</Type><Comment><![CDATA[ indicates which buttons will be available in test client, CAN be written by test if it signals g_bCaseUsesDialog=true ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_nDialogResponseInvokeId</Name><Type>DWORD</Type><Comment><![CDATA[ the invocation Id that was processed last and for which the g_nDialogResponse is valid for, written by Client ]]></Comment><BitSize>32</BitSize></SubItem><SubItem><Name Static="true">g_nDialogResponse</Name><Type>DWORD</Type><Comment><![CDATA[ indicates which button in test client was pressed, written by Client ]]></Comment><BitSize>32</BitSize></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Tc3_PlcTestUtilitiesGeneric">GVL_AdsErrorCodes</Name><SubItem><Name Static="true">ADSERR_NOERR</Name><Type>UDINT</Type><Comment><![CDATA[No error.]]></Comment><BitSize>32</BitSize><Default><Value>0</Value></Default></SubItem><SubItem><Name Static="true">ADSERR_DEVICE_ERROR</Name><Type>UDINT</Type><Comment><![CDATA[General device error.]]></Comment><BitSize>32</BitSize><Default><Value>1792</Value></Default></SubItem><SubItem><Name Static="true">ADSERR_DEVICE_SRVNOT