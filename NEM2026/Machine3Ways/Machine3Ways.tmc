<Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property><Property><Name>no_explicit_call</Name><Value>This FB is a CLASS and must be accessed using methods or properties</Value></Property><Property><Name>conditionalshow</Name></Property><Property><Name>suppress_warning_0</Name><Value>C0094</Value></Property></Properties></DataType><DataType><Name Namespace="XtsCore">NullXtsMoverTaskResult</Name><BitSize>96</BitSize><Implements Namespace="XtsCore">I_XtsMoverTaskResult</Implements><Implements Namespace="XtsCore">I_NullObject</Implements><Method><Name>__getAborted</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Local><Name>Aborted</Name><Type>BOOL</Type><BitSize>8</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__getError</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Local><Name>Error</Name><Type>BOOL</Type><BitSize>8</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__getCommandExecuted</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Local><Name>CommandExecuted</Name><Type>BOOL</Type><BitSize>8</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__getTaskName</Name><ReturnType>STRING(80)</ReturnType><ReturnBitSize>648</ReturnBitSize><Local><Name>TaskName</Name><Type>STRING(80)</Type><BitSize>648</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__getErrorId</Name><ReturnType>UDINT</ReturnType><ReturnBitSize>32</ReturnBitSize><Local><Name>ErrorId</Name><Type>UDINT</Type><BitSize>32</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__getBusy</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Local><Name>Busy</Name><Type>BOOL</Type><BitSize>8</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>__getTaskId</Name><ReturnType Namespace="XtsCore">MoverTaskID</ReturnType><ReturnBitSize>32</ReturnBitSize><Local><Name>TaskId</Name><Type Namespace="XtsCore">MoverTaskID</Type><BitSize>32</BitSize></Local><Properties><Property><Name>property</Name></Property></Properties></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property><Property><Name>no_explicit_call</Name><Value>This FB is a CLASS and must be accessed using methods or properties</Value></Property><Property><Name>conditionalshow</Name></Property><Property><Name>suppress_warning_0</Name><Value>C0094</Value></Property><Property><Name>suppress_warning_1</Name><Value>C0568</Value></Property></Properties></DataType><DataType><Name Namespace="XtsCore.Tc3_McCollisionAvoidance">MC_GAP_CONTROL_MODE</Name><BitSize>32</BitSize><BaseType>UDINT</BaseType><EnumInfo><Text>mcGapControlModeGroupDefault</Text><Enum>0</Enum></EnumInfo><EnumInfo><Text>mcGapControlModeStandard</Text><Enum>1</Enum></EnumInfo><EnumInfo><Text>mcGapControlModeFast</Text><Enum>2</Enum></EnumInfo><EnumInfo><Text>mcGapControlModeNone</Text><Enum>3</Enum></EnumInfo></DataType><DataType><Name Namespace="XtsCore.Tc3_McCollisionAvoidance">MC_MASTER_SIGNAL_CORRECTION</Name><BitSize>16</BitSize><BaseType>INT</BaseType><EnumInfo><Text>mcMasterSignalCorrectionAuto</Text><Enum>0</Enum></EnumInfo><EnumInfo><Text>mcMasterSignalCorrectionNone</Text><Enum>1</Enum></EnumInfo></DataType><DataType><Name Namespace="XtsCore.Tc3_McCollisionAvoidance">ST_GearInPosCAOptions</Name><Comment><![CDATA[The Options can be set to specialize the synchronization profile of the slave further.]]></Comment><BitSize>576</BitSize><SubItem><Name>AfterSyncVelocity</Name><Type GUID="{0100FF8A-3F83-4535-990A-614CFBA4DA63}" Namespace="MC">MC_LREAL</Type><Comment><![CDATA[Maximal slave axis velocity after the slave has become synchronous for the first time. The velocity is limited by the maximum slave axis velocity. If no value is entered, the default value is used (see CA-Group Parameter GearInPosAfterSyncDynamics).]]></Comment><BitSize>64</BitSize><BitOffs>0</BitOffs><Default><Value>1E+300</Value></Default></SubItem><SubItem><Name>AfterSyncAcceleration</Name><Type GUID="{0100FF8A-3F83-4535-990A-614CFBA4DA63}" Namespace="MC">MC_LREAL</Type><Comment><![CDATA[Maximal slave axis acceleration after the slave has become synchronous for the first time. The acceleration is limited by the maximum slave axis acceleration. If no value is entered, the default value is used (see CA-Group Parameter GearInPosAfterSyncDynamics).]]></Comment><BitSize>64</BitSize><BitOffs>64</BitOffs><Default><Value>1E+300</Value></Default></SubItem><SubItem><Name>AfterSyncDeceleration</Name><Type GUID="{0100FF8A-3F83-4535-990A-614CFBA4DA63}" Namespace="MC">MC_LREAL</Type><Comment><![CDATA[Maximal slave axis deceleration after the slave has become synchronous for the first time. The deceleration is limited by the maximum slave axis deceleration. If no value is entered, the default value is used (see CA-Group Parameter GearInPosAfterSyncDynamics).]]></Comment><BitSize>64</BitSize><BitOffs>128</BitOffs><Default><Value>1E+300</Value></Default></SubItem><SubItem><Name>AfterSyncJerk</Name><Type GUID="{0100FF8A-3F83-4535-990A-614CFBA4DA63}" Namespace="MC">MC_LREAL</Type><Comment><![CDATA[Maximal slave axis jerk after the slave has become synchronous for the first time. The jerk is not limited by other jerk values (an axis maximum jerk cannot be configured). If no value is entered, the default value is used (see CA-Group Parameter GearInPosAfterSyncDynamics).]]></Comment><BitSize>64</BitSize><BitOffs>192</BitOffs><Default><Value>1E+300</Value></Default></SubItem><SubItem><Name>MasterVelocityUndershootAllowed</Name><Type>BOOL</Type><Comment><![CDATA[If set to FALSE, the slave velocity during the synchronization phase is always larger or equal to the master velocity. If the slave velocity is smaller than the master velocity at the time the command is issued, the slave will accelerate with its synchronization dynamics to reach the master velocity as soon as possible.
	MasterVelocityUndershootAllowed and MasterVelocityOvershootAllowed cannot both be set to FALSE.]]></Comment><BitSize>8</BitSize><BitOffs>256</BitOffs><Default><Bool>true</Bool></Default></SubItem><SubItem><Name>MasterVelocityOvershootAllowed</Name><Type>BOOL</Type><Comment><![CDATA[If set to FALSE, the slave velocity during the synchronization phase is always smaller or equal to the master velocity. If the slave velocity is larger than the master velocity at the time the command is issued, the slave will decelerate with its synchronization dynamics to the master velocity.
	MasterVelocityUndershootAllowed and MasterVelocityOvershootAllowed cannot both be set to FALSE.]]></Comment><BitSize>8</BitSize><BitOffs>264</BitOffs><Default><Bool>true</Bool></Default></SubItem><SubItem><Name>MinimalSlavePosition</Name><Type GUID="{0100FF8A-3F83-4535-990A-614CFBA4DA63}" Namespace="MC">MC_LREAL</Type><Comment><![CDATA[Absolute minimal position of the slave during the synchronization phase. This option has effect only on the synchronization profile and has no effect once the slave is InSync.]]></Comment><BitSize>64</BitSize><BitOffs>320</BitOffs><Default><Value>1E+301</Value></Default></SubItem><SubItem><Name>DirectionReversalAllowed</Name><Type>BOOL</Type><Comment><![CDATA[If set to FALSE, the slave is not allowed to move in the opposite direction. The direction is determined by the sign of the slave velocity in the SlaveSyncPosition (gear ratio * master velocity).]]></Comment><BitSize>8</BitSize><BitOffs>384</BitOffs><Default><Bool>true</Bool></Default></SubItem><SubItem><Name>OverrideSlaveDynamicRestrictions</Name><Type>BOOL</Type><Comment><![CDATA[If set to FALSE, the Synchronization profile of the slave is recalculated every time the master velocity changes. This might lead to a high load if the master velocity changes every cycle, e.g. if the master is accelerating or decelerating or if an encoder axis is used as master axis.
If set to TRUE, the movement of the master is impressed on the synchronization profile of the slave, the synchronization profile of the master is not recalculated if the master velocity changes.
This might lead to a violation of the dynamic restrictions of the slave, depending on the movement of the master. This option makes it possible to synchronize on encoder axes with the strategies mcSyncStrategyLate and mcSyncStrategySlow.]]></Comment><BitSize>8</BitSize><BitOffs>392</BitOffs><Default><Bool>false</Bool></Default></SubItem><SubItem><Name>GapControlMode</Name><Type Namespace="XtsCore.Tc3_McCollisionAvoidance">MC_GAP_CONTROL_MODE</Type><BitSize>32</BitSize><BitOffs>416</BitOffs><Default><EnumText>MC_GAP_CONTROL_MODE.mcGapControlModeGroupDefault</EnumText></Default></SubItem><SubItem><Name>SlaveSyncPositionReferenceSystem</Name><Type GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</Type><BitSize>32</BitSize><BitOffs>448</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>DynamicsReferenceSystem</Name><Type GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</Type><BitSize>32</BitSize><BitOffs>480</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>MasterSignalCorrection</Name><Type Namespace="XtsCore.Tc3_McCollisionAvoidance">MC_MASTER_SIGNAL_CORRECTION</Type><Comment><![CDATA[Specifies whether and how the input from the master is corrected before being processed further by the GearInPosCA. ]]></Comment><BitSize>16</BitSize><BitOffs>512</BitOffs><Default><EnumText>MC_MASTER_SIGNAL_CORRECTION.mcMasterSignalCorrectionAuto</EnumText></Default></SubItem></DataType><DataType><Name Namespace="XtsCore.Tc3_Mc3Definitions">MC_SYNC_MODE</Name><Comment><![CDATA[ Defines the direction of the synchronization position of modulo axes. ]]></Comment><BitSize>16</BitSize><BaseType>UINT</BaseType><EnumInfo><Text>mcSyncModeNonModulo</Text><Enum>0</Enum><Comment><![CDATA[ SyncSlavePosition is interpreted as absolute position. ]]></Comment></EnumInfo><EnumInfo><Text>mcSyncModePositive</Text><Enum>1</Enum><Comment><![CDATA[ Synchronizes in positive direction. ]]></Comment></EnumInfo><EnumInfo><Text>mcSyncModeNegative</Text><Enum>3</Enum><Co