<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationFill" Id="{4753414c-a703-4b45-97a6-136cea5a4edd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationFill EXTENDS FB_StationBase
VAR_INPUT
    FlowRate         : LREAL;
    TargetVolume     : LREAL;
END_VAR
VAR_OUTPUT
    OpenFillValve    : BOOL;
END_VAR
VAR
    Accumulated      : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AllowPause" Id="{8ec93571-9f3f-4772-82c4-0f824c43364f}">
      <Declaration><![CDATA[// CR-1 OVERRIDE: Fill must not be pausable mid-stroke.
// Returns FALSE while State = 10 (filling) so the base's Monitoring
// keeps ActiveMode at the prior value rather than going to 3 (Pause).
METHOD PROTECTED AllowPause : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AllowPause := (State <> 10);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteSequence" Id="{7012b869-cba7-4451-a462-d26725a9ae47}">
      <Declaration><![CDATA[METHOD PROTECTED ExecuteSequence
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.ExecuteSequence();

CASE State OF
    0:
        OpenFillValve := FALSE;
        Done          := FALSE;
        Accumulated   := 0.0;
        IF Execute AND PartPresent AND ActiveMode = 1 THEN
            THIS^.TransitionTo(10);
        END_IF
    10:
        OpenFillValve := TRUE;
        Timeout(IN := TRUE, PT := T#10S);
        IF Timeout.Q THEN
            THIS^.RaiseStationAlarm(1000, 'Fill: Timeout');
        END_IF
        IF FlowRate < 0.1 THEN
            THIS^.RaiseStationAlarm(1001, 'Fill: No flow detected');
        END_IF
        Accumulated := Accumulated + (FlowRate * 0.001);
        IF Accumulated >= TargetVolume THEN
            THIS^.TransitionTo(20);
        END_IF
    20:
        OpenFillValve := FALSE;
        Timeout(IN := FALSE);
        // CR-3: log cycle data via base helper (gated by LoggingEnabled())
        THIS^.LogCycleData(Note := 'Fill cycle complete');
        Done := TRUE;
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetStepName" Id="{263d6cd9-6cc0-4b5d-93a1-b87fa2ae9031}">
      <Declaration><![CDATA[METHOD PROTECTED GetStepName : STRING(40)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE State OF
    0:  GetStepName := 'Idle';
    10: GetStepName := 'Filling';
    20: GetStepName := 'Complete';
ELSE
    GetStepName := 'Unknown';
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="AllowPause" Id="{8ec93571-9f3f-4772-82c4-0f824c43364f}">
      <Declaration><![CDATA[// CR-1 OVERRIDE: Fill must not be pausable mid-stroke.
// Returns FALSE while State = 10 (filling) so the base's Monitoring
// keeps ActiveMode at the prior value rather than going to 3 (Pause).
METHOD PROTECTED AllowPause : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AllowPause := (State <> 10);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="LoggingEnabled" Id="{d013a472-e12b-4b37-ac79-1a6b8b778d53}">
      <Declaration><![CDATA[// CR-3 OVERRIDE: Fill participates in cycle logging.
METHOD PROTECTED LoggingEnabled : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LoggingEnabled := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>