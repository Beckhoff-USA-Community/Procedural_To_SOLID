<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{cdd055d9-64d9-4bc7-ab8e-6be4692f1de7}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // shared HMI inputs
    Execute              : BOOL;
    ModeAuto             : BOOL;
    ModeManual           : BOOL;
    ModePause            : BOOL;       // CR-1
    AlarmAck             : BOOL;

    // station instances — Name init is the SPT idiom
    StationFill          : FB_StationFill    := (Name := 'Fill');
    StationCap           : FB_StationCap     := (Name := 'Cap');
    StationLabel         : FB_StationLabel   := (Name := 'Label');
    StationInspect       : FB_StationInspect := (Name := 'Inspect');

    // process inputs
    PartFill             : BOOL;
    FlowRate             : LREAL := 1.0;
    TargetVolume         : LREAL := 250.0;

    PartCap              : BOOL;
    CapFeederReady       : BOOL;
    TorqueLimit          : LREAL := 5.0;
    TorqueActual         : LREAL;

    PartLabel            : BOOL;
    LabelReady           : BOOL;
    ApplyPressure        : LREAL := 2.0;

    PartInspect          : BOOL;
    CameraReady          : BOOL;
    InspectResult        : BOOL;
    QualityIssueDetected : BOOL;       // CR-2
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[StationFill(
    Execute      := Execute,
    ModeAuto     := ModeAuto,
    ModeManual   := ModeManual,
    ModePause    := ModePause,
    PartPresent  := PartFill,
    AlarmAck     := AlarmAck,
    FlowRate     := FlowRate,
    TargetVolume := TargetVolume);
StationFill.CyclicLogic();

StationCap(
    Execute        := Execute,
    ModeAuto       := ModeAuto,
    ModeManual     := ModeManual,
    ModePause      := ModePause,
    PartPresent    := PartCap,
    AlarmAck       := AlarmAck,
    CapFeederReady := CapFeederReady,
    TorqueLimit    := TorqueLimit,
    TorqueActual   := TorqueActual);
StationCap.CyclicLogic();

StationLabel(
    Execute       := Execute,
    ModeAuto      := ModeAuto,
    ModeManual    := ModeManual,
    ModePause     := ModePause,
    PartPresent   := PartLabel,
    AlarmAck      := AlarmAck,
    LabelReady    := LabelReady,
    ApplyPressure := ApplyPressure);
StationLabel.CyclicLogic();

StationInspect(
    Execute              := Execute,
    ModeAuto             := ModeAuto,
    ModeManual           := ModeManual,
    PartPresent          := PartInspect,
    AlarmAck             := AlarmAck,
    CameraReady          := CameraReady,
    InspectResult        := InspectResult,
    QualityIssueDetected := QualityIssueDetected);
StationInspect.CyclicLogic();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>