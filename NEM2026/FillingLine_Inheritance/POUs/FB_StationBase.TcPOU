<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationBase" Id="{bc3c8fc6-ecac-4bf1-83f0-ca59597c7418}" SpecialFunc="None">
    <Declaration><![CDATA[// Abstract station base — extends the SPT-Libraries FB_ComponentBase.
// CR-1: ModePause + AllowPause() virtual (pollutes base for Fill's exception)
FUNCTION_BLOCK FB_StationBase EXTENDS SPT_Components.FB_ComponentBase
VAR_INPUT
    Execute      : BOOL;
    ModeAuto     : BOOL;
    ModeManual   : BOOL;
    ModePause    : BOOL;          // CR-1
    PartPresent  : BOOL;
    AlarmAck     : BOOL;
END_VAR
VAR_OUTPUT
    Done         : BOOL;
    StatusText   : STRING(80);
    StateDisplay : INT;
    AlarmActive  : BOOL;
    AlarmText    : STRING(255);
END_VAR
VAR
    State        : INT;
    Timeout      : TON;
    AlarmLatched : BOOL;
    AlarmAckEdge : R_TRIG;
    AlarmCode    : UDINT;
    ActiveMode   : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="AllowPause" Id="{af58a937-62b9-4efc-9fd1-75fd373744f8}">
      <Declaration><![CDATA[// CR-1: virtual flag for Fill's per-station Pause exception.
// Default: TRUE (station can be paused). Fill overrides to FALSE
// while State = 10 so Pause is ignored mid-fill.
//
// Pollution alert: this method exists ONLY to serve Fill. Cap, Label,
// and Inspect carry it as inherited dead weight forever.
METHOD PROTECTED AllowPause : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AllowPause := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{d881dc39-0418-4090-9df1-82c864b09262}">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _InitComplete THEN
    _InitComplete := Initialize();
    RETURN;
END_IF

SUPER^.CyclicLogic();   // framework: invokes Monitoring (overridden below)

THIS^.ExecuteSequence();
THIS^.UpdateHmiStatus();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ExecuteSequence" Id="{aa3954ba-3a32-43cc-b4df-4dc442e58804}">
      <Declaration><![CDATA[METHOD PROTECTED ExecuteSequence
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// CR-1 Pause guard — Cap halts mid-cycle (no Fill-style exception)
IF ActiveMode = 3 THEN
	StatusText := 'Paused';
    RETURN;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetStepName" Id="{54dac95f-0a58-4038-8bf2-f3f7d514eb79}">
      <Declaration><![CDATA[METHOD PROTECTED GetStepName : STRING(40)
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE State OF
    0:   GetStepName := 'Idle';
ELSE
    GetStepName := 'Running';
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Monitoring" Id="{4abe9ebd-cb45-4f39-9ced-488d76d03a4f}">
      <Declaration><![CDATA[METHOD PROTECTED Monitoring
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// CR-1: Pause checks the AllowPause() virtual. Fill overrides it.
IF ModePause AND THIS^.AllowPause() THEN
    ActiveMode := 3;
ELSIF ModeAuto THEN
    ActiveMode := 1;
ELSIF ModeManual THEN
    ActiveMode := 2;
ELSE
    ActiveMode := 0;
END_IF

AlarmAckEdge(CLK := AlarmAck);
IF AlarmLatched AND AlarmAckEdge.Q THEN
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
    _Error       := FALSE;
    _ErrorID     := 0;
END_IF

SUPER^.Monitoring();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseStationAlarm" Id="{3ab655c1-5824-46b5-ae4f-940a438d0eb7}">
      <Declaration><![CDATA[METHOD PROTECTED RaiseStationAlarm
VAR_INPUT
    Code : UDINT;
    Text : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AlarmLatched := TRUE;
AlarmCode    := Code;
AlarmText    := Text;
_Error       := TRUE;
_ErrorID     := Code;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{9d944465-a488-43e1-b861-cfc572ba72f0}">
      <Declaration><![CDATA[METHOD PUBLIC Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[State        := 0;
AlarmLatched := FALSE;
AlarmCode    := 0;
AlarmText    := '';
Done         := FALSE;
Timeout(IN := FALSE);

IF SUPER^.Reset() THEN
    _Error   := FALSE;
    _ErrorID := 0;
    Reset    := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TransitionTo" Id="{db3dc823-f545-4879-89e4-b67f69f0cda3}">
      <Declaration><![CDATA[METHOD PROTECTED TransitionTo
VAR_INPUT
    NextStep : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[State := NextStep;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="UpdateHmiStatus" Id="{d9ca5760-26b3-48bd-941c-c01db03b117f}">
      <Declaration><![CDATA[METHOD PROTECTED UpdateHmiStatus
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StateDisplay := State;
StatusText   := THIS^.GetStepName();
AlarmActive  := AlarmLatched;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>