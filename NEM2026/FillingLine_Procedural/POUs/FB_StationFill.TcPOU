<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StationFill" Id="{c8b56ccb-9e54-404c-b28c-9e8f9a838929}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationFill
VAR_INPUT
    Execute          : BOOL;
    Reset            : BOOL;
    ModeAuto         : BOOL;
    ModeManual       : BOOL;
    ModePause        : BOOL;          // CR-1
    JogForward       : BOOL;
    JogReverse       : BOOL;
    PartPresent      : BOOL;
    AlarmAck         : BOOL;
    FlowRate         : LREAL;
    TargetVolume     : LREAL;
END_VAR
VAR_OUTPUT
    Busy             : BOOL;
    Done             : BOOL;
    Error            : BOOL;
    ErrorID          : UDINT;
    StatusText       : STRING(80);
    StateDisplay     : INT;
    AlarmActive      : BOOL;
    AlarmText        : STRING(255);
    OpenFillValve    : BOOL;
END_VAR
VAR
    State            : INT;
    Timeout          : TON;
    AlarmLatched     : BOOL;
    AlarmAckEdge     : R_TRIG;
    AlarmCode        : UDINT;
    ActiveMode       : INT;
    Accumulated      : LREAL;
    LogBuffer        : ARRAY[0..99] OF STRING(120);   // CR-3 (duplicated in Inspect)
    LogIndex         : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// mode + Pause (CR-1)
IF ModePause THEN
    ActiveMode := 3;
ELSIF ModeAuto THEN
    ActiveMode := 1;
ELSIF ModeManual THEN
    ActiveMode := 2;
ELSE
    ActiveMode := 0;
END_IF

// alarm ack — Fill uses RISING EDGE
AlarmAckEdge(CLK := AlarmAck);
IF AlarmLatched AND AlarmAckEdge.Q THEN
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
END_IF

IF Reset THEN
    State        := 0;
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
    Timeout(IN := FALSE);
    Accumulated  := 0.0;
    Done         := FALSE;
END_IF

CASE State OF
    0:  StatusText := 'Idle';
    10: StatusText := 'Filling';
    20: StatusText := 'Complete';
ELSE
    StatusText := 'Unknown';
END_CASE
Busy        := (State <> 0) AND NOT Done;
AlarmActive := AlarmLatched;
Error       := AlarmLatched;
ErrorID     := AlarmCode;

// CR-1 Pause guard — Fill exception: ignore Pause while State = 10 (mid-fill)
IF ActiveMode = 3 AND State <> 10 THEN
	StatusText := 'Paused';
    RETURN;
END_IF

// State machine
CASE State OF
    0:
        OpenFillValve := FALSE;
        Done          := FALSE;
        Accumulated   := 0.0;
        IF Execute AND PartPresent AND ActiveMode = 1 THEN
            State := 10;
        END_IF
    10:
        OpenFillValve := TRUE;
        Timeout(IN := TRUE, PT := T#10S);
        IF Timeout.Q THEN
            AlarmLatched := TRUE;
            AlarmCode    := 1000;
            AlarmText    := 'Fill: Timeout';
        END_IF
        IF FlowRate < 0.1 THEN
            AlarmLatched := TRUE;
            AlarmCode    := 1001;
            AlarmText    := 'Fill: No flow detected';
        END_IF
        Accumulated := Accumulated + (FlowRate * 0.001);
        IF Accumulated >= TargetVolume THEN
            State := 20;
        END_IF
    20:
        OpenFillValve := FALSE;
        Timeout(IN := FALSE);
        // CR-3: cycle data logging (duplicated identically in FB_StationInspect)
        LogBuffer[LogIndex] := 'Fill cycle complete';
        LogIndex := (LogIndex + 1) MOD 100;
        Done := TRUE;
END_CASE

StateDisplay := State;
CASE State OF
    0:  StatusText := 'Idle';
    10: StatusText := 'Filling';
    20: StatusText := 'Complete';
ELSE
    StatusText := 'Unknown';
END_CASE
Busy        := (State <> 0) AND NOT Done;
AlarmActive := AlarmLatched;
Error       := AlarmLatched;
ErrorID     := AlarmCode;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
