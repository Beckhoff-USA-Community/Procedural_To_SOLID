<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StationLabel" Id="{43aa657a-066e-45f8-a8e9-bdac046f77cf}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationLabel
VAR_INPUT
    Execute          : BOOL;
    Reset            : BOOL;
    ModeAuto         : BOOL;
    ModeManual       : BOOL;
    ModePause        : BOOL;          // CR-1
    JogForward       : BOOL;
    JogReverse       : BOOL;
    PartPresent      : BOOL;
    AlarmAck         : BOOL;
    LabelReady       : BOOL;
    ApplyPressure    : LREAL;
END_VAR
VAR_OUTPUT
    Busy             : BOOL;
    Done             : BOOL;
    Error            : BOOL;
    ErrorID          : UDINT;
    StatusText       : STRING(80);
    StateDisplay     : INT;
    AlarmActive      : BOOL;
    AlarmText        : STRING(255);
    ExtendApplicator : BOOL;
    LabelVacuum      : BOOL;
END_VAR
VAR
    State            : INT;
    Timeout          : TON;
    ApplySettle      : TON;
    AlarmLatched     : BOOL;
    AlarmAckEdge     : R_TRIG;
    AlarmCode        : UDINT;
    ActiveMode       : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// mode + Pause (CR-1)
IF ModePause THEN
    ActiveMode := 3;
ELSIF ModeAuto THEN
    ActiveMode := 1;
ELSIF ModeManual THEN
    ActiveMode := 2;
ELSE
    ActiveMode := 0;
END_IF

// alarm ack — RISING EDGE (matches Fill)
AlarmAckEdge(CLK := AlarmAck);
IF AlarmLatched AND AlarmAckEdge.Q THEN
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
END_IF

IF Reset THEN
    State        := 0;
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
    Timeout(IN := FALSE);
    ApplySettle(IN := FALSE);
    Done         := FALSE;
END_IF

// HMI mapping
StateDisplay := State;
CASE State OF
    0:   StatusText := 'Idle';
    100: StatusText := 'Picking Label';
    200: StatusText := 'Applying';
    300: StatusText := 'Complete';
ELSE
    StatusText := 'Unknown';
END_CASE
Busy        := (State <> 0) AND NOT Done;
AlarmActive := AlarmLatched;
Error       := AlarmLatched;
ErrorID     := AlarmCode;

// CR-1 Pause guard — Label halts mid-cycle
IF ActiveMode = 3 THEN
	StatusText := 'Paused';
    RETURN;
END_IF

// State machine
CASE State OF
    0:
        LabelVacuum      := FALSE;
        ExtendApplicator := FALSE;
        Done             := FALSE;
        IF Execute AND PartPresent AND LabelReady AND ActiveMode = 1 THEN
            State := 100;
        END_IF
    100:
        LabelVacuum := TRUE;
        ApplySettle(IN := TRUE, PT := T#300MS);
        IF ApplySettle.Q THEN
            ApplySettle(IN := FALSE);
            State := 200;
        END_IF
    200:
        ExtendApplicator := TRUE;
        ApplySettle(IN := TRUE, PT := T#400MS);
        Timeout(IN := TRUE, PT := T#3S);
        IF Timeout.Q THEN
            AlarmLatched := TRUE;
            AlarmCode    := 3001;
            AlarmText    := 'Label: Apply timeout';
        END_IF
        IF ApplySettle.Q THEN
            ApplySettle(IN := FALSE);
            ExtendApplicator := FALSE;
            Timeout(IN := FALSE);
            State := 300;
        END_IF
    300:
        LabelVacuum := FALSE;
        Done := TRUE;
END_CASE

StateDisplay := State;
CASE State OF
    0:   StatusText := 'Idle';
    100: StatusText := 'Picking Label';
    200: StatusText := 'Applying';
    300: StatusText := 'Complete';
ELSE
    StatusText := 'Unknown';
END_CASE
Busy        := (State <> 0) AND NOT Done;
AlarmActive := AlarmLatched;
Error       := AlarmLatched;
ErrorID     := AlarmCode;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
