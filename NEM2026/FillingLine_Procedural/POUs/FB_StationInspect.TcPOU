<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationInspect" Id="{91553ce4-5302-4417-b061-d593d00cc1c0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationInspect
VAR_INPUT
    Execute          : BOOL;
    Reset            : BOOL;
    ModeAuto         : BOOL;
    ModeManual       : BOOL;
    ModePause        : BOOL;          // CR-1
    JogForward       : BOOL;
    JogReverse       : BOOL;
    PartPresent      : BOOL;
    AlarmAck         : BOOL;
    CameraReady      : BOOL;
    InspectResult    : BOOL;
END_VAR
VAR_OUTPUT
    Busy             : BOOL;
    Done             : BOOL;
    Error            : BOOL;
    ErrorID          : UDINT;
    StatusText       : STRING(80);
    StateDisplay     : INT;
    AlarmActive      : BOOL;
    AlarmText        : STRING(255);
    TriggerCamera    : BOOL;
    RejectPusher     : BOOL;
    PassResult       : BOOL;
END_VAR
VAR
    State            : INT;
    Timeout          : TON;
    CameraDelay      : TON;
    AlarmLatched     : BOOL;
    AlarmCode        : UDINT;
    ActiveMode       : INT;
    ManualStep       : INT;        // dead variable — legacy cruft
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// mode + Pause (CR-1)
IF ModePause THEN
    ActiveMode := 3;
ELSIF ModeAuto THEN
    ActiveMode := 1;
ELSIF ModeManual THEN
    ActiveMode := 2;
ELSE
    ActiveMode := 0;
END_IF

// alarm ack
IF AlarmLatched AND AlarmAck THEN
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
END_IF

// Reset
IF Reset THEN
    State        := 0;
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
    Timeout(IN := FALSE);
    CameraDelay(IN := FALSE);
    Done         := FALSE;
END_IF

// HMI Mapping
StateDisplay := State;
CASE State OF
    0:  StatusText := 'Idle';
    10: StatusText := 'Inspecting';
    20: StatusText := 'Evaluate';
    25: StatusText := 'Rejecting';
    30: StatusText := 'Complete';
ELSE
    StatusText := 'Unknown';
END_CASE
Busy        := (State <> 0) AND NOT Done;
AlarmActive := AlarmLatched;
Error       := AlarmLatched;
ErrorID     := AlarmCode;

// CR-1 Pause guard — Inspect halts mid-cycle
IF ActiveMode = 3 THEN
	StatusText := 'Paused';
    RETURN;
END_IF

// State machine
CASE State OF
    0:
        TriggerCamera := FALSE;
        RejectPusher  := FALSE;
        PassResult    := FALSE;
        Done          := FALSE;
        IF Execute AND PartPresent AND CameraReady AND ActiveMode = 1 THEN
            State := 10;
        END_IF
    10:
        TriggerCamera := TRUE;
        CameraDelay(IN := TRUE, PT := T#200MS);
        Timeout(IN := TRUE, PT := T#2S);
        IF Timeout.Q THEN
            AlarmLatched := TRUE;
            AlarmCode    := 4001;
            AlarmText    := 'Inspect: Camera timeout';
        END_IF
        IF CameraDelay.Q THEN
            CameraDelay(IN := FALSE);
            Timeout(IN := FALSE);
            TriggerCamera := FALSE;
            State := 20;
        END_IF
    20:
        IF InspectResult THEN
            PassResult := TRUE;
            State      := 30;
        ELSE
            PassResult := FALSE;
            State      := 25;
        END_IF
    25:
        RejectPusher := TRUE;
        CameraDelay(IN := TRUE, PT := T#300MS);
        IF CameraDelay.Q THEN
            CameraDelay(IN := FALSE);
            RejectPusher := FALSE;
            State := 30;
        END_IF
    30:
        Done := TRUE;
END_CASE

]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>