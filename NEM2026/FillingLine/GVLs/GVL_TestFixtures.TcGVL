<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_TestFixtures" Id="{aca1fa8e-92d0-4d43-a0f3-f7c469e3c754}">
    <Declaration><![CDATA[// Shared dependency fixtures for FB_TestRunner station integration tests.
//
// Why globals: TwinCAT requires a constructor-style initializer when an
// FB's FB_init has user-defined inputs (FB_StationFill / FB_StationInspect
// take ModeRef + AlarmHandler + DataLogger). The compiler ALSO refuses to
// resolve those init args against locally-declared FB instances in the
// same VAR_INST block ("The initial value for a VAR_INST variable may not
// use local variables"). Globals are the only references the compiler
// will accept in a VAR_INST initializer, so the test fixtures live here.
//
// Tests share these instances; each station test resets shared state at
// the start (Mode flags + Alarm.Clear()) so prior test residue can't leak.
VAR_GLOBAL
    Mode             : FB_ModeManager;
    AlarmLineFault   : FB_AlarmHandler_LineFault;
    AlarmQualityFlag : FB_AlarmHandler_QualityFlag;
    Logger           : FB_CycleDataLogger;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
