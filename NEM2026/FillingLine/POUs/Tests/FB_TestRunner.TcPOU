<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_TestRunner" Id="{6eabea62-5d7b-49b6-9f56-191c79da1ec2}" SpecialFunc="None">
    <Declaration><![CDATA[// Unit tests for stage-3-complete using PlcTestSuite by SimmelFlo.
// https://github.com/SimmelFlo/PlcTestSuite
//
// The point of this FB is to demonstrate that composition (Stage 3) makes
// PLC code testable in a way Stage 1 / Stage 2 cannot match. Every
// dependency is injected via FB_Init; tests construct their unit-under-test
// with mock-or-real dependencies and exercise behavior without touching
// real I/O.
//
// Drive from MAIN with: TestRunner();   (ungated — every scan runs all
// tests; PlcTestSuite tracks which tests have already executed and only
// re-runs them on TestSuite.ReRunTests()).
FUNCTION_BLOCK FB_TestRunner
VAR
    // building-block instances under test (or used as injected dependencies)
    TestModeManager : FB_ModeManager;
    TestLineFault   : FB_AlarmHandler_LineFault;
    TestQualityFlag : FB_AlarmHandler_QualityFlag;
    TestSequencer   : FB_StepSequencer;
    TestParallel    : FB_ParallelSequencer;
    TestLogger      : FB_CycleDataLogger;

    // Fill station integration test harness — injected with shared mocks
    UnitFill : FB_StationFill(ModeRef     := TestModeManager,
                              AlarmHandler := TestLineFault,
                              DataLogger   := TestLogger);

    // Inspect station integration test harness — uses QualityFlag strategy
    // to demonstrate Liskov substitution at the alarm-handler boundary
    UnitInspect : FB_StationInspect(ModeRef     := TestModeManager,
                                    AlarmHandler := TestQualityFlag,
                                    DataLogger   := TestLogger);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Building-block tests
THIS^.Test_ModeManager_AutoModeAllowsRun();
THIS^.Test_ModeManager_PauseOverridesAuto();
THIS^.Test_ModeManager_IsPausedProperty();
THIS^.Test_LineFault_LatchesOnRaise();
THIS^.Test_LineFault_StopsLineIsTrue();
THIS^.Test_LineFault_AcknowledgeOnRisingEdge();
THIS^.Test_QualityFlag_FlagsOnRaise();
THIS^.Test_QualityFlag_StopsLineIsFalse();
THIS^.Test_StepSequencer_TransitionUpdatesStepName();
THIS^.Test_StepSequencer_MarkCompleteSetsFlag();
THIS^.Test_ParallelSequencer_AllBranchesComplete();
THIS^.Test_CycleDataLogger_IsEnabled();

// Station integration tests — these exercise the composition pattern
THIS^.Test_FillStation_HappyPath_CompletesCycle();
THIS^.Test_FillStation_NoFlow_RaisesAlarm();
THIS^.Test_FillStation_PauseBlocksNewCycle();
THIS^.Test_InspectStation_QualityFlagDoesNotFault();
]]></ST>
    </Implementation>

    <Method Name="Test_ModeManager_AutoModeAllowsRun" Id="{9c087bcf-7c39-4c3f-8ead-602d3dece11e}">
      <Declaration><![CDATA[// Given ModeAuto, expect AllowRun = TRUE and CurrentMode = 1.
METHOD Test_ModeManager_AutoModeAllowsRun
VAR_INST
    Local : FB_ModeManager;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.ModeAuto := TRUE;
    Local.ModeManual := FALSE;
    Local.ModePause := FALSE;
    Local.CyclicUpdate();
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.AllowRun);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(1, Local.CurrentMode);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_ModeManager_PauseOverridesAuto" Id="{26c3394c-ae67-4014-8545-a336bdf4aa8b}">
      <Declaration><![CDATA[// CR-1 verification: ModePause overrides ModeAuto.
// Mode must be 3 (Paused) and AllowRun must be FALSE.
METHOD Test_ModeManager_PauseOverridesAuto
VAR_INST
    Local : FB_ModeManager;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.ModeAuto := TRUE;        // would be Auto
    Local.ModePause := TRUE;       // but Pause wins
    Local.CyclicUpdate();
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(3, Local.CurrentMode);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Local.AllowRun);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_ModeManager_IsPausedProperty" Id="{b91b6947-6507-469e-afa4-4f94d352f7ac}">
      <Declaration><![CDATA[// CR-1: IsPaused property returns TRUE only when paused.
METHOD Test_ModeManager_IsPausedProperty
VAR_INST
    Local : FB_ModeManager;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.ModePause := TRUE;
    Local.CyclicUpdate();
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.IsPaused);

    Local.ModePause := FALSE;
    Local.ModeAuto  := TRUE;
    Local.CyclicUpdate();
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Local.IsPaused);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_LineFault_LatchesOnRaise" Id="{50a26625-8264-4361-a758-8281b56dc4c1}">
      <Declaration><![CDATA[// LineFault strategy: RaiseAlarm latches HasActiveAlarm = TRUE.
METHOD Test_LineFault_LatchesOnRaise
VAR_INST
    Local : FB_AlarmHandler_LineFault;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.RaiseAlarm(Code := 1234, Text := 'unit test alarm');
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.HasActiveAlarm);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_LineFault_StopsLineIsTrue" Id="{036bd1cf-9922-498b-a4c9-95aa4311c190}">
      <Declaration><![CDATA[// Strategy A policy declaration: StopsLine = TRUE.
// Stations consult this to compute IsFaulted.
METHOD Test_LineFault_StopsLineIsTrue
VAR_INST
    Local : FB_AlarmHandler_LineFault;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.StopsLine);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_LineFault_AcknowledgeOnRisingEdge" Id="{3f35d296-7b9f-40b0-915a-97fff756971a}">
      <Declaration><![CDATA[// LineFault: Acknowledge clears the latch only on AckInput rising edge.
// A held-high AckInput from a previous scan must NOT clear it.
METHOD Test_LineFault_AcknowledgeOnRisingEdge
VAR_INST
    Local : FB_AlarmHandler_LineFault;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.RaiseAlarm(Code := 100, Text := 'pre-test latch');

    // First Acknowledge call with AckInput = TRUE — establishes the level
    // for the R_TRIG. The alarm should clear because the rising edge is
    // captured against the FB's initial FALSE state of _AckEdge.CLK.
    Local.Acknowledge(AckInput := TRUE);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Local.HasActiveAlarm);

    // Re-raise and verify level-held AckInput does NOT clear (no new edge)
    Local.RaiseAlarm(Code := 101, Text := 're-raise');
    Local.Acknowledge(AckInput := TRUE);   // still TRUE — no edge
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.HasActiveAlarm);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_QualityFlag_FlagsOnRaise" Id="{407387d1-b81f-44f2-a0bd-18f69e8b580b}">
      <Declaration><![CDATA[// QualityFlag strategy: RaiseAlarm flags HasActiveAlarm but does
// not latch in a stop-the-line sense.
METHOD Test_QualityFlag_FlagsOnRaise
VAR_INST
    Local : FB_AlarmHandler_QualityFlag;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.RaiseAlarm(Code := 4002, Text := 'visual defect');
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.HasActiveAlarm);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_QualityFlag_StopsLineIsFalse" Id="{bc79706a-bf93-4bcf-8619-28b6df9f52f3}">
      <Declaration><![CDATA[// THE Liskov substitution proof: FB_AlarmHandler_QualityFlag has the
// same interface (I_AlarmHandler) as FB_AlarmHandler_LineFault but
// declares the OPPOSITE policy via StopsLine = FALSE.
//
// Stations consult Alarm.StopsLine when computing IsFaulted, so the
// SAME station code yields different fault behavior depending on
// which alarm handler is injected.
METHOD Test_QualityFlag_StopsLineIsFalse
VAR_INST
    Local : FB_AlarmHandler_QualityFlag;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Local.StopsLine);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_StepSequencer_TransitionUpdatesStepName" Id="{2564c946-3f9b-4eef-825b-d86f598bb757}">
      <Declaration><![CDATA[// FB_StepSequencer: TransitionTo updates both CurrentStep and StepName.
METHOD Test_StepSequencer_TransitionUpdatesStepName
VAR_INST
    Local : FB_StepSequencer;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.SetStepName(Step := 0,  Name := 'Idle');
    Local.SetStepName(Step := 10, Name := 'Working');

    Local.TransitionTo(NextStep := 10);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(10, Local.CurrentStep);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual('Working', Local.StepName);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_StepSequencer_MarkCompleteSetsFlag" Id="{b80bd1fd-9498-418a-adc0-e952477a8565}">
      <Declaration><![CDATA[// FB_StepSequencer: MarkComplete sets the Complete flag,
// which stations expose via I_Sequenceable.IsComplete.
METHOD Test_StepSequencer_MarkCompleteSetsFlag
VAR_INST
    Local : FB_StepSequencer;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Local.Complete);
    Local.MarkComplete();
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.Complete);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_ParallelSequencer_AllBranchesComplete" Id="{2a5920ec-d27e-43a7-9b02-099080ec79c1}">
      <Declaration><![CDATA[// FB_ParallelSequencer: AllBranchesComplete only flips TRUE after
// every configured branch has been marked done.
METHOD Test_ParallelSequencer_AllBranchesComplete
VAR_INST
    Local : FB_ParallelSequencer;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.Configure(NumberOfBranches := 2);

    Local.MarkBranchDone(BranchIndex := 0);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Local.AllBranchesComplete);

    Local.MarkBranchDone(BranchIndex := 1);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.AllBranchesComplete);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_CycleDataLogger_IsEnabled" Id="{228d3346-dcd2-487c-803e-919c3c099f5f}">
      <Declaration><![CDATA[// Default state of FB_CycleDataLogger is enabled (logs accepted).
METHOD Test_CycleDataLogger_IsEnabled
VAR_INST
    Local : FB_CycleDataLogger;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Local.IsEnabled);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_FillStation_HappyPath_CompletesCycle" Id="{72db1547-dcd8-418d-a3e7-3646d07f8b41}">
      <Declaration><![CDATA[// Integration: drive UnitFill (instantiated above with TestModeManager,
// TestLineFault, TestLogger) through a complete cycle and assert
// IsComplete = TRUE at the end.
//
// Tiny TargetVolume + unity FlowRate lets the cycle complete in three
// synchronous Execute() calls without needing real time to elapse.
// Watchdog TON doesn't fire because T#10S >> our test duration.
METHOD Test_FillStation_HappyPath_CompletesCycle
VAR_INST
    Local           : FB_ModeManager;
    LocalAlarm      : FB_AlarmHandler_LineFault;
    LocalLogger     : FB_CycleDataLogger;
    Unit            : FB_StationFill(ModeRef     := Local,
                                     AlarmHandler := LocalAlarm,
                                     DataLogger   := LocalLogger);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.ModeAuto := TRUE;
    Local.CyclicUpdate();

    Unit.PartPresent  := TRUE;
    Unit.FlowRate     := 1.0;
    Unit.TargetVolume := 0.001;     // tiny target — completes in one Accumulate step

    Unit.Execute();   // State 0 → 10 (Idle → Filling, watchdog enabled)
    Unit.Execute();   // Accumulated += 0.001 → triggers TransitionTo(20)
    Unit.Execute();   // State 20 → MarkComplete

    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Unit.IsComplete);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Unit.IsFaulted);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_FillStation_NoFlow_RaisesAlarm" Id="{a245e930-e7c5-4e84-a9ec-ba6b844778e5}">
      <Declaration><![CDATA[// Integration: when FlowRate is below threshold during Filling state,
// the station raises a LineFault alarm. With LineFault injected,
// IsFaulted goes TRUE.
METHOD Test_FillStation_NoFlow_RaisesAlarm
VAR_INST
    Local       : FB_ModeManager;
    LocalAlarm  : FB_AlarmHandler_LineFault;
    LocalLogger : FB_CycleDataLogger;
    Unit        : FB_StationFill(ModeRef     := Local,
                                 AlarmHandler := LocalAlarm,
                                 DataLogger   := LocalLogger);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.ModeAuto := TRUE;
    Local.CyclicUpdate();

    Unit.PartPresent  := TRUE;
    Unit.FlowRate     := 0.0;       // below 0.1 threshold
    Unit.TargetVolume := 100.0;

    Unit.Execute();   // State 0 → 10
    Unit.Execute();   // FlowRate < 0.1 — RaiseAlarm fires

    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, LocalAlarm.HasActiveAlarm);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, Unit.IsFaulted);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_FillStation_PauseBlocksNewCycle" Id="{4cb2f5a1-b751-4faf-bd23-47db9546bba4}">
      <Declaration><![CDATA[// CR-1 integration: when ModePause is asserted before a cycle starts,
// the station does not transition out of Idle (state 0).
//
// This proves the Pause behavior at the integration layer — the
// FB_ModeManager change propagates correctly to a station that only
// consults Mode.AllowRun.
METHOD Test_FillStation_PauseBlocksNewCycle
VAR_INST
    Local       : FB_ModeManager;
    LocalAlarm  : FB_AlarmHandler_LineFault;
    LocalLogger : FB_CycleDataLogger;
    Unit        : FB_StationFill(ModeRef     := Local,
                                 AlarmHandler := LocalAlarm,
                                 DataLogger   := LocalLogger);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    Local.ModeAuto  := TRUE;
    Local.ModePause := TRUE;       // CR-1: paused
    Local.CyclicUpdate();

    Unit.PartPresent  := TRUE;
    Unit.FlowRate     := 1.0;
    Unit.TargetVolume := 0.001;

    Unit.Execute();   // would normally transition 0 → 10, but AllowRun is FALSE
    Unit.Execute();
    Unit.Execute();

    // station should still be at step 0, not complete
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(0, Unit.StateNumber);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, Unit.IsComplete);
END_IF
]]></ST>
      </Implementation>
    </Method>

    <Method Name="Test_InspectStation_QualityFlagDoesNotFault" Id="{636ff492-2cff-47bb-9982-9d1713f2f835}">
      <Declaration><![CDATA[// CR-2 integration: with FB_AlarmHandler_QualityFlag injected, an
// alarm raise from inside the station produces HasActiveAlarm = TRUE
// but IsFaulted = FALSE (because StopsLine = FALSE on the strategy).
//
// This is the architectural payoff: the SAME station code exhibits
// non-faulting behavior when a different strategy is injected. The
// station never knew which alarm strategy it had.
METHOD Test_InspectStation_QualityFlagDoesNotFault
VAR_INST
    Local         : FB_ModeManager;
    LocalQuality  : FB_AlarmHandler_QualityFlag;
    LocalLogger   : FB_CycleDataLogger;
    Unit          : FB_StationInspect(ModeRef     := Local,
                                      AlarmHandler := LocalQuality,
                                      DataLogger   := LocalLogger);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).ExecuteTest() THEN
    // Directly raise an alarm via the strategy and verify the policy.
    // (Driving the full Inspect cycle through state 10's parallel
    // branches would require TON time-advance; the strategy contract
    // is what carries the architectural lesson.)
    LocalQuality.RaiseAlarm(Code := 4002, Text := 'visual defect');

    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(TRUE, LocalQuality.HasActiveAlarm);
    Tc3_PlcTestSuite.TestSuite.Test(__POUNAME()).AssertEqual(FALSE, LocalQuality.StopsLine);

    // Now: a station consuming this alarm computes IsFaulted as
    //   Alarm.HasActiveAlarm AND Alarm.StopsLine
    // → TRUE AND FALSE → FALSE. Quality alarms don't fault the line.
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
