<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_StationCap" Id="{995aa1f9-2aab-436e-9cda-670bc81baac1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StationCap
VAR_INPUT
    Execute          : BOOL;
    Reset            : BOOL;
    ModeAuto         : BOOL;
    ModeManual       : BOOL;
    ModePause        : BOOL;
    JogForward       : BOOL;
    JogReverse       : BOOL;
    PartPresent      : BOOL;
    AlarmAck         : BOOL;
    CapFeederReady   : BOOL;
    TorqueLimit      : LREAL;
END_VAR
VAR_OUTPUT
    Busy             : BOOL;
    Done             : BOOL;
    Error            : BOOL;
    ErrorID          : UDINT;
    StatusText       : STRING(80);
    StateDisplay     : INT;
    AlarmActive      : BOOL;
    AlarmText        : STRING(255);
    RunCapMotor      : BOOL;
    CapPickCylinder  : BOOL;
END_VAR
VAR
    State            : INT;
    Timeout          : TON;
    CapSettle        : TON;
    AlarmLatched     : BOOL;
    AlarmCode        : UDINT;
    ActiveMode       : INT;
    TorqueActual     : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// mode 
IF ModePause THEN
    ActiveMode := 3;
ELSIF ModeAuto THEN
    ActiveMode := 1;
ELSIF ModeManual THEN
    ActiveMode := 2;
ELSE
    ActiveMode := 0;
END_IF

// alarm ack 
IF AlarmLatched AND AlarmAck THEN
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
END_IF

// Reset
IF Reset THEN
    State        := 0;
    AlarmLatched := FALSE;
    AlarmCode    := 0;
    AlarmText    := '';
    Timeout(IN := FALSE);
    CapSettle(IN := FALSE);
    Done         := FALSE;
END_IF

// HMI Mapping
StateDisplay := State;
CASE State OF
    0:  StatusText := 'Idle';
    10: StatusText := 'Pick Cap';
    20: StatusText := 'Torquing';
    30: StatusText := 'Complete';
ELSE
    StatusText := 'Unknown';
END_CASE
Busy        := (State <> 0) AND NOT Done;
AlarmActive := AlarmLatched;
Error       := AlarmLatched;
ErrorID     := AlarmCode;

// State machine
CASE State OF
    0:
        RunCapMotor     := FALSE;
        CapPickCylinder := FALSE;
        Done            := FALSE;
        IF Execute AND PartPresent AND CapFeederReady AND ActiveMode = 1 THEN
            State := 10;
        END_IF
    10:
        CapPickCylinder := TRUE;
        CapSettle(IN := TRUE, PT := T#500MS);
        IF CapSettle.Q THEN
            CapSettle(IN := FALSE);
            State := 20;
        END_IF
    20:
        RunCapMotor := TRUE;
        Timeout(IN := TRUE, PT := T#5S);
        IF Timeout.Q THEN
            AlarmLatched := TRUE;
            AlarmCode    := 2001;
            AlarmText    := 'Cap: Torque timeout';
        END_IF
        IF TorqueActual >= TorqueLimit THEN
            RunCapMotor := FALSE;
            Timeout(IN := FALSE);
            State := 30;
        END_IF
    30:
        CapPickCylinder := FALSE;
        Done := TRUE;
END_CASE

]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>