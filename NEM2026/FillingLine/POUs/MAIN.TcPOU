<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{03461180-5cd9-4381-8d28-8c1758009ed3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // shared HMI inputs
    Execute         : BOOL;
    ModeAuto        : BOOL;
    ModeManual      : BOOL;
    AlarmAck        : BOOL;

    // station instances — Name init is the SPT idiom; FB_ComponentBase
    // uses Name for diagnostic prefixes and event-logger string params.
    StationFill     : FB_StationFill    := (Name := 'Fill');
    StationCap      : FB_StationCap     := (Name := 'Cap');
    StationLabel    : FB_StationLabel   := (Name := 'Label');
    StationInspect  : FB_StationInspect := (Name := 'Inspect');

    // process inputs (wire to real I/O when integrated)
    PartFill        : BOOL;
    FlowRate        : LREAL := 1.0;
    TargetVolume    : LREAL := 250.0;

    PartCap         : BOOL;
    CapFeederReady  : BOOL;
    TorqueLimit     : LREAL := 5.0;
    TorqueActual    : LREAL;

    PartLabel       : BOOL;
    LabelReady      : BOOL;
    ApplyPressure   : LREAL := 2.0;

    PartInspect          : BOOL;
    CameraReady          : BOOL;
    InspectResult        : BOOL;
    QualityIssueDetected : BOOL;   // CR-2 — non-faulting quality input
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[StationFill(
    Execute      := Execute,
    ModeAuto     := ModeAuto,
    ModeManual   := ModeManual,
    PartPresent  := PartFill,
    AlarmAck     := AlarmAck,
    FlowRate     := FlowRate,
    TargetVolume := TargetVolume);
StationFill.CyclicLogic();

StationCap(
    Execute        := Execute,
    ModeAuto       := ModeAuto,
    ModeManual     := ModeManual,
    PartPresent    := PartCap,
    AlarmAck       := AlarmAck,
    CapFeederReady := CapFeederReady,
    TorqueLimit    := TorqueLimit,
    TorqueActual   := TorqueActual);
StationCap.CyclicLogic();

StationLabel(
    Execute       := Execute,
    ModeAuto      := ModeAuto,
    ModeManual    := ModeManual,
    PartPresent   := PartLabel,
    AlarmAck      := AlarmAck,
    LabelReady    := LabelReady,
    ApplyPressure := ApplyPressure);
StationLabel.CyclicLogic();

StationInspect(
    Execute              := Execute,
    ModeAuto             := ModeAuto,
    ModeManual           := ModeManual,
    PartPresent          := PartInspect,
    AlarmAck             := AlarmAck,
    CameraReady          := CameraReady,
    InspectResult        := InspectResult,
    QualityIssueDetected := QualityIssueDetected);
StationInspect.CyclicLogic();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
