<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{03461180-5cd9-4381-8d28-8c1758009ed3}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // ----- shared services -----
    ModeManager  : FB_ModeManager;

    // ----- per-station alarm strategies -----
    // stage-3-composition: Inspect now uses QualityFlag — defects flag but
    // don't latch or stop the line. Fill/Cap/Label still use LineFault.
    // Stations are unaware of the swap (interface-typed dependency).
    FillAlarm    : FB_AlarmHandler_LineFault;
    CapAlarm     : FB_AlarmHandler_LineFault;
    LabelAlarm   : FB_AlarmHandler_LineFault;
    InspectAlarm : FB_AlarmHandler_QualityFlag;

    // ----- stations composed via FB_Init dependency injection -----
    StationFill    : FB_StationFill(ModeRef := ModeManager, AlarmHandler := FillAlarm);
    StationCap     : FB_StationCap(ModeRef := ModeManager, AlarmHandler := CapAlarm);
    StationLabel   : FB_StationLabel(ModeRef := ModeManager, AlarmHandler := LabelAlarm);
    StationInspect : FB_StationInspect(ModeRef := ModeManager, AlarmHandler := InspectAlarm);

    // ----- shared HMI inputs -----
    ModeAuto      : BOOL;
    ModeManual    : BOOL;
    ModePause     : BOOL;   // CR-1 — wired to every station individually
    AlarmAck      : BOOL;

    // ----- per-station process inputs -----
    PartFill      : BOOL;
    FlowRate      : LREAL := 1.0;
    TargetVolume  : LREAL := 250.0;

    PartCap        : BOOL;
    CapFeederReady : BOOL;
    TorqueLimit    : LREAL := 5.0;
    TorqueActual   : LREAL;

    PartLabel      : BOOL;
    LabelReady     : BOOL;
    ApplyPressure  : LREAL := 2.0;

    PartInspect    : BOOL;
    CameraReady    : BOOL;
    InspectResult  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// shared mode update
ModeManager.ModeAuto   := ModeAuto;
ModeManager.ModeManual := ModeManual;
ModeManager.CyclicUpdate();

// HMI Ack drives every alarm handler — both LineFault (consumes) and
// QualityFlag (ignores) honor the same I_AlarmHandler.Acknowledge contract.
FillAlarm.Acknowledge(AckInput    := AlarmAck);
CapAlarm.Acknowledge(AckInput     := AlarmAck);
LabelAlarm.Acknowledge(AckInput   := AlarmAck);
InspectAlarm.Acknowledge(AckInput := AlarmAck);

// Fill
StationFill.PartPresent  := PartFill;
StationFill.FlowRate     := FlowRate;
StationFill.TargetVolume := TargetVolume;
StationFill.ModePause    := ModePause;          // CR-1
StationFill.Execute();

// Cap
StationCap.PartPresent    := PartCap;
StationCap.CapFeederReady := CapFeederReady;
StationCap.TorqueLimit    := TorqueLimit;
StationCap.TorqueActual   := TorqueActual;
StationCap.ModePause      := ModePause;         // CR-1
StationCap.Execute();

// Label
StationLabel.PartPresent   := PartLabel;
StationLabel.LabelReady    := LabelReady;
StationLabel.ApplyPressure := ApplyPressure;
StationLabel.ModePause     := ModePause;        // CR-1
StationLabel.Execute();

// Inspect
StationInspect.PartPresent   := PartInspect;
StationInspect.CameraReady   := CameraReady;
StationInspect.InspectResult := InspectResult;
StationInspect.ModePause     := ModePause;      // CR-1
StationInspect.Execute();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
