<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_AlarmHandler_LineFault" Id="{a88f011a-45df-4273-b742-27fc7c3d3ecf}" SpecialFunc="None">
    <Declaration><![CDATA[// Latching alarm strategy — stops the line until acknowledged.
// Default for all stations except those that need a soft quality flag.
FUNCTION_BLOCK FB_AlarmHandler_LineFault IMPLEMENTS I_AlarmHandler
VAR_INPUT
    AckInput     : BOOL;
END_VAR
VAR
    _Latched     : BOOL;
    _ActiveCode  : UDINT;
    _ActiveText  : STRING(255);
    _AckEdge     : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="RaiseAlarm" Id="{4c61f67e-a373-44fe-8e96-e8a85ab5b6da}">
      <Declaration><![CDATA[METHOD RaiseAlarm : BOOL
VAR_INPUT
    Code : UDINT;
    Text : STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Latched    := TRUE;
_ActiveCode := Code;
_ActiveText := Text;
RaiseAlarm  := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Acknowledge" Id="{81416eb2-d7f5-4edf-9dfd-47014b6183b0}">
      <Declaration><![CDATA[METHOD Acknowledge : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AckEdge(CLK := AckInput);
IF _Latched AND _AckEdge.Q THEN
    _Latched    := FALSE;
    _ActiveCode := 0;
    _ActiveText := '';
    Acknowledge := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clear" Id="{d9b0c82a-f928-4076-9aeb-ee8f4563d55e}">
      <Declaration><![CDATA[METHOD Clear : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Latched    := FALSE;
_ActiveCode := 0;
_ActiveText := '';
Clear       := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasActiveAlarm" Id="{ec23ad1b-e83f-4d8d-af80-f069120156dc}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY HasActiveAlarm : BOOL
]]></Declaration>
      <Get Name="Get" Id="{3b581a37-8aed-4407-918e-1a220d54e7f0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasActiveAlarm := _Latched;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="AlarmText" Id="{063a8b74-4a8d-4290-9415-14ed5931a925}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY AlarmText : STRING(255)
]]></Declaration>
      <Get Name="Get" Id="{f0bf89c5-d237-4bb1-9f00-2dbd629b8afa}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[AlarmText := _ActiveText;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StopsLine" Id="{17b14649-f464-46c7-b766-da576e458d40}">
      <Declaration><![CDATA[PROPERTY StopsLine : BOOL
]]></Declaration>
      <Get Name="Get" Id="{74d9288d-eac0-42a7-b4d2-edb6342360fe}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[StopsLine := TRUE;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
