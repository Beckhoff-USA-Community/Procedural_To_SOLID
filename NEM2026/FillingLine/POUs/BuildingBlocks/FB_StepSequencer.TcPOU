<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StepSequencer" Id="{6ee6b16c-0239-4377-bd0a-4217eb74a9e7}" SpecialFunc="None">
    <Declaration><![CDATA[// Linear step sequencer — owns CurrentStep + step name table + complete/fault flags.
// Stations call SetStepName(N, 'Label') in FB_Init; TransitionTo(N) during sequencing.
FUNCTION_BLOCK FB_StepSequencer
VAR_OUTPUT
    CurrentStep : INT;
    Complete    : BOOL;
    Faulted     : BOOL;
    StepName    : STRING(40);
END_VAR
VAR
    _StepNames  : ARRAY[0..30] OF STRING(40);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="SetStepName" Id="{60e7db2f-ac76-4857-b213-cb2b60f52646}">
      <Declaration><![CDATA[METHOD SetStepName : BOOL
VAR_INPUT
    Step : INT;
    Name : STRING(40);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Step >= 0 AND Step <= 30 THEN
    _StepNames[Step] := Name;
END_IF
SetStepName := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TransitionTo" Id="{a280f2da-cbfe-4529-8ec7-2a4f70941481}">
      <Declaration><![CDATA[METHOD TransitionTo : BOOL
VAR_INPUT
    NextStep : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NextStep >= 0 AND NextStep <= 30 THEN
    CurrentStep  := NextStep;
    StepName     := _StepNames[NextStep];
    TransitionTo := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MarkComplete" Id="{35e0d76c-8792-4228-bd25-5a4cef52fff2}">
      <Declaration><![CDATA[METHOD MarkComplete : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Complete     := TRUE;
MarkComplete := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MarkFaulted" Id="{83c6ebe0-0e27-43e7-9bbe-e61991c89d73}">
      <Declaration><![CDATA[METHOD MarkFaulted : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Faulted     := TRUE;
MarkFaulted := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSequencer" Id="{292fa029-b8cf-47a5-910f-572faea6acb1}">
      <Declaration><![CDATA[METHOD ResetSequencer : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CurrentStep    := 0;
StepName       := _StepNames[0];
Complete       := FALSE;
Faulted        := FALSE;
ResetSequencer := TRUE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
